{
  "name": "@kodyazicam/ctxpack",
  "version": "1.1.0",
  "description": "Pack a codebase into LLM-ready context. Respects .gitignore, budgets tokens, redacts secrets, and exposes an MCP server for AI agents.",
  "keywords": [
    "llm",
    "ai",
    "context",
    "prompt",
    "cli",
    "tokenizer",
    "chatgpt",
    "claude",
    "copilot",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "llm-tools"
  ],
  "license": "Apache-2.0",
  "author": "Batuhan (KodYazicam) <https://github.com/KodYazicam>",
  "homepage": "https://github.com/KodYazicam/ctxpack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KodYazicam/ctxpack.git"
  },
  "bugs": {
    "url": "https://github.com/KodYazicam/ctxpack/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "ctxpack": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": [
    "dist",
    "assets/banner.svg",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck",
    "test": "npm run typecheck && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "tiktoken": "^1.0.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
