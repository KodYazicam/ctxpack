{
  "name": "@kodyazicam/ctxpack",
  "version": "1.0.1",
  "description": "Pack a codebase into LLM-ready context. Respects .gitignore, budgets tokens, redacts secrets.",
  "keywords": [
    "llm",
    "ai",
    "context",
    "prompt",
    "cli",
    "tokenizer",
    "chatgpt",
    "claude",
    "copilot"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Batuhan (KodYazicam) <https://github.com/KodYazicam>",
  "homepage": "https://github.com/KodYazicam/ctxpack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KodYazicam/ctxpack.git"
  },
  "bugs": {
    "url": "https://github.com/KodYazicam/ctxpack/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "ctxpack": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets/banner.svg",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "optionalDependencies": {
    "tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
